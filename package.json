{
  "name": "test-filter-service",
  "version": "1.0.0",
  "description": "Service for managing E2E test disable filters in CI/CD pipelines",
  "main": "dist/index.js",
  "scripts": {
    "swagger": "ts-node src/swagger/gen.ts",
    "build": "npm run format:check && npm run test:coverage && npm run test:integration && npm run swagger && tsc",
    "docker:mongo:dev": "docker compose up -d mongo-dev",
    "docker:mongo:dev:down": "docker compose stop mongo-dev && docker compose rm -f mongo-dev",
    "dev:local": "npm run docker:mongo:dev && npm run swagger",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest --verbose",
    "test:coverage": "jest --verbose --coverage",
    "test:integration": "jest --verbose --config jest.integration.config.ts",
    "test:integration:coverage": "jest --verbose --coverage --config jest.integration.config.ts",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^6.3.0",
    "morgan": "^1.10.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "prettier": "^3.2.4",
    "supertest": "^7.2.2",
    "swagger-autogen": "^2.23.7",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
